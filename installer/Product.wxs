<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package Name="EFTX Tilt Desktop" Manufacturer="EFTX ANTENNAS" Version="$(var.Version)"
           ProductCode="$(var.ProductCode)" UpgradeCode="69BB6A93-58DF-488F-B5C8-5D88112A3E6D"
           Language="1046" Codepage="1252" Scope="perUser" InstallerVersion="500">
    <SummaryInformation Description="Calculadora EFTX de tilt elétrico" Manufacturer="EFTX ANTENNAS" />
    <MajorUpgrade DowngradeErrorMessage="Uma versão mais recente do EFTX Tilt já está instalada."
                  Schedule="afterInstallInitialize" />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />
    <Property Id="EFTX_WINDOWS_BUILD">
      <RegistrySearch Id="WindowsBuild" Root="HKLM"
                      Key="SOFTWARE\Microsoft\Windows NT\CurrentVersion"
                      Name="CurrentBuildNumber" Type="raw" Bitness="always64" />
    </Property>
    <Launch Condition="Installed OR (VersionNT64 AND EFTX_WINDOWS_BUILD &gt;= 17763)"
            Message="O EFTX Tilt requer Windows 10 versão 1809 ou posterior (64 bits), ou Windows 11 (64 bits)." />
    <Launch Condition="Installed OR UILevel &gt;= 5 OR EFTX_ACCEPT_LICENSE = &quot;1&quot;"
            Message="Leia LICENSE.txt. Para instalação silenciosa autorizada, informe EFTX_ACCEPT_LICENSE=1." />
    <Property Id="EFTX_ACCEPT_LICENSE" Secure="yes" />
    <Property Id="EFTX_MSI_FOLDER" Secure="yes">
      <RegistrySearch Id="SavedInstallFolder" Root="HKCU" Key="Software\EFTX\Tilt"
                      Name="InstallLocation" Type="raw" Bitness="always64" />
    </Property>
    <Property Id="EFTX_EXE_FOLDER" Secure="yes">
      <RegistrySearch Id="LegacyExeFolder" Root="HKCU" Key="Software\EFTX\TiltSetup"
                      Name="InstallLocation" Type="raw" Bitness="always64" />
    </Property>
    <Property Id="EFTX_EXE_VERSION" Secure="yes">
      <RegistrySearch Id="LegacyExeVersion" Root="HKCU" Key="Software\EFTX\TiltSetup"
                      Name="Version" Type="raw" Bitness="always64" />
    </Property>
    <Property Id="INSTALLFOLDER" Secure="yes" />
    <SetProperty Id="INSTALLFOLDER" Action="ReuseExeFolder" Value="[EFTX_EXE_FOLDER]"
                 Before="CostFinalize" Sequence="both" Condition="EFTX_EXE_FOLDER AND NOT Installed" />
    <SetProperty Id="INSTALLFOLDER" Action="ReuseMsiFolder" Value="[EFTX_MSI_FOLDER]"
                 Before="CostFinalize" Sequence="both" Condition="EFTX_MSI_FOLDER AND (NOT EFTX_EXE_FOLDER OR Installed)" />
    <Launch Condition="Installed OR NOT EFTX_EXE_FOLDER OR EFTX_EXE_VERSION = &quot;1.3.2&quot; OR EFTX_EXE_VERSION = &quot;1.4.0&quot;"
            Message="A instalação EXE encontrada não é uma versão anterior reconhecida. Use uma versão MSI mais recente ou contate a EFTX." />
    <!-- Adopt unversioned files from NSIS as well as versioned DLLs. Without
         force-copy, MSI can retain a locally modified/unversioned old executable. -->
    <Property Id="REINSTALLMODE" Value="amus" />
    <Property Id="MsiLogging" Value="voicewarmupx" />
    <Property Id="MSIRESTARTMANAGERCONTROL" Value="DisableShutdown" />
    <Property Id="ARPPRODUCTICON" Value="EftxIcon" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/Gecesars/tilt" />
    <Property Id="ARPCONTACT" Value="EFTX ANTENNAS" />
    <Property Id="MSIDISABLERMRESTART" Value="1" />
    <Icon Id="EftxIcon" SourceFile="$(var.AssetsDir)\eftx.ico" />
    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsFolder" Name="Programs">
        <Directory Id="EftxProgramsFolder" Name="EFTX">
          <Directory Id="INSTALLFOLDER" Name="Tilt-Desktop" />
        </Directory>
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="EftxMenuFolder" Name="EFTX Tilt Desktop" />
    </StandardDirectory>
    <StandardDirectory Id="DesktopFolder" />
    <Component Id="Shortcuts" Directory="INSTALLFOLDER" Guid="86620DC9-CE74-4484-AFE0-414DB6858DA2">
      <Shortcut Id="MenuShortcut" Directory="EftxMenuFolder" Name="EFTX Tilt"
                Target="[INSTALLFOLDER]EFTX_Tilt.exe" WorkingDirectory="INSTALLFOLDER" Icon="EftxIcon" />
      <Shortcut Id="DesktopShortcut" Directory="DesktopFolder" Name="EFTX Tilt Desktop"
                Target="[INSTALLFOLDER]EFTX_Tilt.exe" WorkingDirectory="INSTALLFOLDER" Icon="EftxIcon" />
      <Shortcut Id="LicenseShortcut" Directory="EftxMenuFolder" Name="Licença EFTX Tilt"
                Target="[INSTALLFOLDER]LICENSE.txt" WorkingDirectory="INSTALLFOLDER" />
      <RegistryValue Root="HKCU" Key="Software\EFTX\Tilt" Name="InstallLocation"
                     Type="string" Value="[INSTALLFOLDER]" KeyPath="yes" />
      <RegistryValue Root="HKCU" Key="Software\EFTX\Tilt" Name="Version"
                     Type="string" Value="[ProductVersion]" />
      <RegistryValue Root="HKCU" Key="Software\EFTX\Tilt" Name="InstallerType"
                     Type="string" Value="MSI" />
      <RemoveFolder Id="RemoveMenu" Directory="EftxMenuFolder" On="uninstall" />
      <RemoveFolder Id="RemoveInstall" Directory="INSTALLFOLDER" On="uninstall" />
      <RemoveFolder Id="RemoveVendor" Directory="EftxProgramsFolder" On="uninstall" />
    </Component>
    <!-- Transactional adoption of the previous per-user NSIS installation.
         Never run its uninstaller after adopting the files: it would delete
         the newly managed payload. Only its exact bookkeeping files are removed. -->
    <Component Id="AdoptLegacyExe" Directory="INSTALLFOLDER" Guid="A4E7623E-B35C-4F2F-B373-2794E7FA0CDF"
               Condition="EFTX_EXE_FOLDER">
      <RemoveRegistryKey Id="RemoveLegacyExeRegistration" Root="HKCU" Key="Software\EFTX\TiltSetup" Action="removeOnInstall" />
      <RemoveRegistryKey Id="RemoveLegacyExeArp" Root="HKCU" Key="Software\Microsoft\Windows\CurrentVersion\Uninstall\EFTXTiltDesktop" Action="removeOnInstall" />
      <RemoveFile Id="RemoveLegacyUninstaller" Name="Desinstalar.exe" On="install" />
      <RemoveFile Id="RemoveLegacyReceipt" Name=".eftx-install.ini" On="install" />
      <RemoveFile Id="RemoveLegacyUninstallLink" Directory="EftxMenuFolder" Name="Desinstalar.lnk" On="install" />
      <RegistryValue Root="HKCU" Key="Software\EFTX\Tilt" Name="MigratedFromExe"
                     Type="string" Value="[EFTX_EXE_VERSION]" KeyPath="yes" />
    </Component>
    <Feature Id="Application" Title="EFTX Tilt" Level="1">
      <ComponentGroupRef Id="PayloadFiles" />
      <ComponentRef Id="Shortcuts" />
      <ComponentRef Id="AdoptLegacyExe" />
    </Feature>
    <ui:WixUI Id="WixUI_Minimal" />
    <WixVariable Id="WixUILicenseRtf" Value="$(var.AssetsDir)\license.rtf" />
    <WixVariable Id="WixUIBannerBmp" Value="$(var.AssetsDir)\banner.bmp" />
    <WixVariable Id="WixUIDialogBmp" Value="$(var.AssetsDir)\dialog.bmp" />
  </Package>
</Wix>
