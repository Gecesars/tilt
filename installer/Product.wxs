<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package Name="EFTX Tilt" Manufacturer="EFTX ANTENNAS" Version="$(var.Version)"
           ProductCode="$(var.ProductCode)" UpgradeCode="69BB6A93-58DF-488F-B5C8-5D88112A3E6D"
           Language="1046" Codepage="1252" Scope="perUser" InstallerVersion="500">
    <SummaryInformation Description="Calculadora EFTX de tilt elétrico" Manufacturer="EFTX ANTENNAS" />
    <MajorUpgrade DowngradeErrorMessage="Uma versão mais recente do EFTX Tilt já está instalada."
                  Schedule="afterInstallInitialize" />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />
    <Launch Condition="VersionNT64" Message="Este instalador requer Windows de 64 bits." />
    <Launch Condition="Installed OR UILevel &gt;= 5 OR EFTX_ACCEPT_LICENSE = &quot;1&quot;"
            Message="Leia LICENSE.txt. Para instalação silenciosa autorizada, informe EFTX_ACCEPT_LICENSE=1." />
    <Property Id="EFTX_ACCEPT_LICENSE" Secure="yes" />
    <Property Id="INSTALLFOLDER" Secure="yes">
      <RegistrySearch Id="SavedInstallFolder" Root="HKCU" Key="Software\EFTX\Tilt"
                      Name="InstallLocation" Type="raw" Bitness="always64" />
    </Property>
    <Property Id="ARPPRODUCTICON" Value="EftxIcon" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/Gecesars/tilt" />
    <Property Id="ARPCONTACT" Value="EFTX ANTENNAS" />
    <Property Id="MSIDISABLERMRESTART" Value="1" />
    <Icon Id="EftxIcon" SourceFile="$(var.AssetsDir)\eftx.ico" />
    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsFolder" Name="Programs">
        <Directory Id="EftxProgramsFolder" Name="EFTX">
          <Directory Id="INSTALLFOLDER" Name="Tilt" />
        </Directory>
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="EftxMenuFolder" Name="EFTX" />
    </StandardDirectory>
    <StandardDirectory Id="DesktopFolder" />
    <Component Id="Shortcuts" Directory="INSTALLFOLDER" Guid="86620DC9-CE74-4484-AFE0-414DB6858DA2">
      <Shortcut Id="MenuShortcut" Directory="EftxMenuFolder" Name="EFTX Tilt"
                Target="[INSTALLFOLDER]EFTX_Tilt.exe" WorkingDirectory="INSTALLFOLDER" Icon="EftxIcon" />
      <Shortcut Id="DesktopShortcut" Directory="DesktopFolder" Name="EFTX Tilt"
                Target="[INSTALLFOLDER]EFTX_Tilt.exe" WorkingDirectory="INSTALLFOLDER" Icon="EftxIcon" />
      <Shortcut Id="LicenseShortcut" Directory="EftxMenuFolder" Name="Licença EFTX Tilt"
                Target="[INSTALLFOLDER]LICENSE.txt" WorkingDirectory="INSTALLFOLDER" />
      <RegistryValue Root="HKCU" Key="Software\EFTX\Tilt" Name="InstallLocation"
                     Type="string" Value="[INSTALLFOLDER]" KeyPath="yes" />
      <RemoveFolder Id="RemoveMenu" Directory="EftxMenuFolder" On="uninstall" />
      <RemoveFolder Id="RemoveInstall" Directory="INSTALLFOLDER" On="uninstall" />
      <RemoveFolder Id="RemoveVendor" Directory="EftxProgramsFolder" On="uninstall" />
    </Component>
    <Feature Id="Application" Title="EFTX Tilt" Level="1">
      <ComponentGroupRef Id="PayloadFiles" />
      <ComponentRef Id="Shortcuts" />
    </Feature>
    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <WixVariable Id="WixUILicenseRtf" Value="$(var.AssetsDir)\license.rtf" />
    <WixVariable Id="WixUIBannerBmp" Value="$(var.AssetsDir)\banner.bmp" />
    <WixVariable Id="WixUIDialogBmp" Value="$(var.AssetsDir)\dialog.bmp" />
  </Package>
</Wix>
